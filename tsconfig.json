{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build/server",
    "rootDir": "src/server",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/server"]
}
