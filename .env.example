# ============================================
# MyAgent 环境变量示例（复制为 .env 后按需填写；不填写则留空）
# 后端启动时自动加载 backend/../.env（项目根）与 backend/.env
# ============================================

# ── 服务基础 ──────────────────────────────
PORT=7980
DATA_DIR=../data
FRONTEND_DIR=../frontend/dist
ADMIN_ACCOUNT=admin
# 管理员密码：必须修改为强密码（代码默认 '123456' 仅用于首次启动，公开部署存在被猜解风险）
ADMIN_PASSWORD=change-me-please

# ── LLM 配置（不再有"出厂默认模型"）──
# 会话模型由用户在前端「设置→模型设置」中选择，并同步保存为服务端全局默认
# （data/global-default-model.json，按用户）。以下环境变量为可选入口：
#  - QWEN_*：通用配置 / Electron 客户端引擎运行时注入通道；未配置即空
#  - CHAT_*/AGENT_*：生成「本地Qwen-chat/agent」预设（两者均配置才生成）
# 全部未配置时，创建会话返回 400「未配置默认模型，请在设置→模型设置中选择模型」
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=

# ── Chat / Agent 模式独立配置（可选，均配置才生成对应预设）──
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=

# ── 系统提示词与工作目录 ──────────────────
SYSTEM_PROMPT=
WORK_DIR=

# ── LLM 行为 ─────────────────────────────
LLM_TIMEOUT_MS=120000
THINKING_LEVEL=medium
ENABLE_THINKING=true
THINKING_BUDGET=1024
PRESERVE_THINKING=false
# 网页版 Agent 执行开关（false 时为瘦服务端模式，Agent 由桌面客户端执行）
WEB_AGENT_ENABLED=true

# ── WebSocket ────────────────────────────
WS_HEARTBEAT_MS=30000

# ── Agent 迭代限制 ───────────────────────
# 注意：运行时实际以 data/rate-limit-config.json 为准（可在设置页修改），
# 这些 env 仅作为初始默认值
AGENT_MAX_TURNS=20
AGENT_MAX_TOOL_CALLS_PER_TURN=10
AGENT_MAX_CONSECUTIVE_ERRORS=5

# ── 云端模型 ─────────────────────────────
# DeepSeek 预设的 API Key（模型预设与上下文压缩摘要模型回退）
DEEPSEEK_API_KEY=

# ── MCP 服务 ─────────────────────────────
# 网络搜索工具（mcp/src/tools/webSearch.js）
TAVILY_API_KEY=

# ── 已废弃（RPC 进程功能已下线，仅保留兼容读取）──
PI_CLI_PATH=
RPC_MAX_PROCESSES=4
RPC_IDLE_TIMEOUT_MS=300000
RPC_HEARTBEAT_MS=30000
RPC_MAX_RESTARTS=5

# ── 已废弃（工具限流从未接线，仅保留兼容读取）──
TOOL_RATE_LIMIT_PER_MIN=20
TOOL_RATE_LIMIT_MAX_ERRORS=5
